{
  "expo": {
    "name": "Whereabouts",
    "slug": "whereabouts",
    "scheme": "whereabouts",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.whereabouts",
      "config": {
        "usesNonExemptEncryption": false
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": [],
        "NSPrivacyCollectedDataTypes": []
      }
    },
    "android": {
      "package": "app.whereabouts",
      "allowBackup": false,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": false
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Whereabouts uses Face ID to unlock the app."
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-font",
      "expo-splash-screen",
      [
        "expo-notifications",
        {
          "color": "#B38B4D"
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Whereabouts uses the camera to photograph your things and boxes so you can recognise them later.",
          "photosPermission": "Whereabouts lets you pick photos of your things.",
          "microphonePermission": false
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Whereabouts listens when you tap the microphone, so you can add or find things by voice. Audio never leaves your phone.",
          "speechRecognitionPermission": "Whereabouts turns what you say into a catalog card, on your phone.",
          "androidSpeechServicePackages": [
            "com.google.android.as",
            "com.google.android.googlequicksearchbox"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
